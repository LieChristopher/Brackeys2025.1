; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Brackeys2025.1"
run/main_scene="res://project/scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
audio_manager="*res://project/scripts/audio-system/audio_manager.tscn"

[dialogic]

directories/dch_directory={
"character_oldMan": "res://project/scripts/dialogic/character_oldMan.dch",
"character_overlay": "res://project/scenes/samples/FullBackground/character_overlay.dch",
"character_player": "res://project/scripts/dialogic/character_player.dch",
"character_poorGuy": "res://project/scripts/dialogic/character_poorGuy.dch",
"character_richGirl": "res://project/scripts/dialogic/character_richGirl.dch"
}
directories/dtl_directory={
"Template_Day01_END": "res://project/scripts/dialogic/Template_Day01_END.dtl",
"Template_Day01_START": "res://project/scripts/dialogic/Template_Day01_START.dtl",
"Template_Day02_BadMood_END": "res://project/scripts/dialogic/Template_Day02_BadMood_END.dtl",
"Template_Day02_GoodMood_END": "res://project/scripts/dialogic/Template_Day02_GoodMood_END.dtl",
"Template_Day02_START": "res://project/scripts/dialogic/Template_Day02_START.dtl",
"oldMan_Day01_END": "res://project/scripts/dialogic/oldMan_Day01_END.dtl",
"oldMan_Day01_START": "res://project/scripts/dialogic/oldMan_Day01_START.dtl",
"oldMan_Day02_BadMood_END": "res://project/scripts/dialogic/oldMan_Day02_BadMood_END.dtl",
"oldMan_Day02_GoodMood_END": "res://project/scripts/dialogic/oldMan_Day02_GoodMood_END.dtl",
"oldMan_Day02_START": "res://project/scripts/dialogic/oldMan_Day02_START.dtl",
"poorGuy_Day01_END": "res://project/scripts/dialogic/poorGuy_Day01_END.dtl",
"poorGuy_Day01_START": "res://project/scripts/dialogic/poorGuy_Day01_START.dtl",
"poorGuy_Day02_BadMood_END": "res://project/scripts/dialogic/poorGuy_Day02_BadMood_END.dtl",
"poorGuy_Day02_GoodMood_END": "res://project/scripts/dialogic/poorGuy_Day02_GoodMood_END.dtl",
"poorGuy_Day02_START": "res://project/scripts/dialogic/poorGuy_Day02_START.dtl",
"richGirl_Day01_END": "res://project/scripts/dialogic/richGirl_Day01_END.dtl",
"richGirl_Day01_START": "res://project/scripts/dialogic/richGirl_Day01_START.dtl",
"richGirl_Day02_BadMood_END": "res://project/scripts/dialogic/richGirl_Day02_BadMood_END.dtl",
"richGirl_Day02_GoodMood_END": "res://project/scripts/dialogic/richGirl_Day02_GoodMood_END.dtl",
"richGirl_Day02_START": "res://project/scripts/dialogic/richGirl_Day02_START.dtl"
}
glossary/default_case_sensitive=true
layout/style_list=[]
layout/default_style=""
variables={
"InteractionCounter": {
"oldMan": 1,
"poorGuy": 1,
"richGirl": 1
},
"MoodGood": {
"oldMan": true,
"poorGuy": true,
"richGirl": true
},
"gameOver": false,
"success": true
}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
audio/max_channels=4.0
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[input]

dialogic_default_action={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
